<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <a href="<%= root_path %>" class="site-title">Blog</a>
        <nav class="site-nav">
          <% if logged_in? %>
            <%= link_to "新規記事", new_admin_post_path %>
            <%= button_to "ログアウト", logout_path, method: :delete, class: "btn-link" %>
          <% else %>
            <%= link_to "ログイン", login_path %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if flash[:alert] %>
        <div class="flash flash-alert"><%= flash[:alert] %></div>
      <% end %>
      <% if flash[:notice] %>
        <div class="flash flash-notice"><%= flash[:notice] %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
