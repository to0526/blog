<% content_for :title, "ログイン" %>

<div class="auth-form">
  <h1>ログイン</h1>

  <%= form_with url: login_path do |f| %>
    <div class="field">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, required: true, autofocus: true %>
    </div>
    <div class="field">
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password, required: true %>
    </div>
    <div class="actions">
      <%= f.submit "ログイン" %>
    </div>
  <% end %>
</div>
